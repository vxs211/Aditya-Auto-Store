# Required
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="909e8f1f8366349e4a3fc9ec3c83e8c8"
NEXT_PUBLIC_SHOPIFY_SHOP_ID="123456789"

# Optional
# AI_GATEWAY_API_KEY="your-ai-gateway-api-key-here" # Shop Agent model access outside Vercel OIDC, such as local development without vercel env pull.
# CRON_SECRET="your-cron-secret-here" # Authorizes scheduled WhatsApp Sheets delivery.
# CUSTOMER_ACCOUNT_SESSION_SECRET="your-session-secret-here"
# DATABASE_URL="postgresql://your-user:your-password@your-host/your-database?sslmode=require" # Neon database for WhatsApp intake.
# DEBUG_SHOPIFY="1" # Log structured Shopify API operation timings.
# GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account-email-here" # Google Sheets service account with access to the order sheet.
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="your-service-account-private-key-here" # Private key for the Sheets service account.
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_ID="123456789"
# REVALIDATE_SECRET="your-revalidate-secret-here" # Set to refresh content Shopify sends no webhook for, such as pages, policies, and menus; send it as a Bearer token to POST /api/revalidate.
# SHOPIFY_API_VERSION="2026-10" # Override the Storefront API version, which defaults to the version Hydrogen targets.
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID="shp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_SECRET="your-customer-account-client-secret-here" # Required when auth.isEnabled is true.
# SHOPIFY_WEBHOOK_SECRET="your-shopify-webhook-secret-here"
# UCP_AGENT_PROFILE_URL="https://your-agent.example.com/agent/ucp-profile.json" # Optional override for the public Eve agent profile.
# WHATSAPP_APP_SECRET="your-whatsapp-app-secret-here" # Meta app secret for verifying webhook signatures.
# WHATSAPP_INTAKE_ENABLED="0" # Enable only after the inbox delivery worker and existing bot are verified.
# WHATSAPP_SHEET_ID="your-spreadsheet-id-here" # Spreadsheet containing the dedicated ingestion tab.
# WHATSAPP_SHEET_TAB="your-sheet-tab-here" # Protected ingestion tab with row 1 reserved for headers.
# WHATSAPP_SHEETS_WORKER_ENABLED="0" # Enable after the dedicated sheet and scheduler are verified.
# WHATSAPP_VERIFY_TOKEN="your-whatsapp-verify-token-here" # Webhook verification token.

# EVE_DEV="1" # Set by eve dev; selects Shopify's public example profile when local URLs are unreachable.
# VERCEL_ENV is provided by Vercel; previews use Shopify's public example agent profile.
